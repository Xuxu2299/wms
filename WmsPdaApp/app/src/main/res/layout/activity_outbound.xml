<?xml version="1.0" encoding="utf-8"?>
<!-- 出库扫码界面。
     已移除 Material Design 组件（MaterialCardView / MaterialButton），
     改用 androidx.cardview.widget.CardView 与标准 Button，兼容旧版 aapt。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1976D2"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="出库扫码"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 可滚动内容区：表单 + 商品列表。
         使用 NestedScrollView（ScrollView 的子类）以正确处理
         内部 RecyclerView 的嵌套滚动，同时配合 windowSoftInputMode=adjustResize 处理软键盘。 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 表单卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- 订单号（只读，自动带入） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="订单号"
                            android:textColor="#424242"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/etOrderNo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:hint="订单号"
                            android:inputType="text"
                            android:singleLine="true"
                            android:minHeight="48dp"
                            android:padding="10dp"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- 容器号（只读，根据起始库位自动带出） + 扫码 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="容器号"
                            android:textColor="#424242"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/etContainerNo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:hint="选择库位后自动带出"
                            android:inputType="text"
                            android:singleLine="true"
                            android:minHeight="48dp"
                            android:padding="10dp"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/btnScanContainer"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="扫码"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:backgroundTint="#1976D2" />
                    </LinearLayout>

                    <!-- 起始库位（已占用库位） + 扫码 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="起始库位"
                            android:textColor="#424242"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spStartLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnScanStartLocation"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="扫码"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:backgroundTint="#1976D2" />
                    </LinearLayout>

                    <!-- 目标库位（出库终点库位） + 扫码 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="目标库位"
                            android:textColor="#424242"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spTargetLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Button
                            android:id="@+id/btnScanTargetLocation"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="扫码"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:backgroundTint="#1976D2" />
                    </LinearLayout>

                    <!-- 商品编码 + 扫码 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="商品编码"
                            android:textColor="#424242"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/etSkuCode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="请扫码/输入商品编码"
                            android:inputType="text"
                            android:singleLine="true"
                            android:minHeight="48dp"
                            android:padding="10dp"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/btnScanSku"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="扫码"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:backgroundTint="#1976D2" />
                    </LinearLayout>

                    <!-- 商品名称 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="商品名称"
                            android:textColor="#424242"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/etMaterialName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="请输入商品名称"
                            android:inputType="text"
                            android:singleLine="true"
                            android:minHeight="48dp"
                            android:padding="10dp"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- 数量 / 金额 并排（数值输入对，节省竖向空间） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="数量"
                                android:textColor="#424242"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etQuantity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="0.00"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:minHeight="48dp"
                                android:padding="10dp"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="12dp"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="金额"
                                android:textColor="#424242"
                                android:textSize="16sp" />

                            <EditText
                                android:id="@+id/etAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:hint="0.00"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:minHeight="48dp"
                                android:padding="10dp"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 添加商品按钮 -->
            <Button
                android:id="@+id/btnAddItem"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="添加商品"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#1976D2" />

            <!-- 已添加商品列表卡片。RecyclerView 固定高度并启用嵌套滚动，
                 列表内部可滚动，到达边界后由外层 NestedScrollView 接管滚动。 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="已添加商品"
                        android:textColor="#212121"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvItems"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:nestedScrollingEnabled="true"
                        android:scrollbars="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部完成出库按钮（固定在底部，常驻可见） -->
    <Button
        android:id="@+id/btnComplete"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="48dp"
        android:text="完成出库"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#1976D2" />

</LinearLayout>
