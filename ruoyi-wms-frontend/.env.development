# 页面标题
VITE_APP_TITLE = ruoyi-wms后台管理系统

# 开发环境配置
VITE_APP_ENV = 'development'

# 若依管理系统/开发环境
# 本地部署使用 Vite 代理到后端 http://localhost:8080
VITE_APP_BASE_API = '/dev-api'
# 如需临时连接线上体验接口，可改回：
# VITE_APP_BASE_API = 'http://cangku.ichengle.top/prod-api'

# 应用访问路径 例如使用前缀 /admin/
VITE_APP_CONTEXT_PATH = '/'

# 监控地址
VITE_APP_MONITRO_ADMIN = 'http://localhost:9090/admin/applications'

# xxl-job 控制台地址
VITE_APP_XXL_JOB_ADMIN = 'http://localhost:9100/xxl-job-admin'
